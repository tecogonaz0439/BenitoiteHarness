{
  "kind": "normal",
  "category": "feature",
  "artifacts": [
    "report.py"
  ],
  "writable_files": [
    "report.py"
  ],
  "allowed_generated": [
    "__pycache__/",
    "tests/__pycache__/"
  ],
  "verify": [
    "python3",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
  ],
  "judge": [
    "python3",
    "-I",
    "judge/verify.py"
  ],
  "required_tools": [
    "python3",
    "/bin/sh"
  ],
  "self_test": {
    "initial_case": "descending_ties",
    "fixed_output": "print(\"[]\")\n",
    "controls": [
      {
        "source": "negative/reverse_ties.py",
        "cases": [
          "descending_ties"
        ]
      }
    ],
    "fixed_output_cases": [
      "descending_ties",
      "ascending",
      "strings",
      "ascending_ties",
      "missing"
    ]
  }
}
