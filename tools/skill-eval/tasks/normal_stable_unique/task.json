{
  "kind": "normal",
  "category": "feature",
  "artifacts": [
    "unique.py"
  ],
  "writable_files": [
    "unique.py"
  ],
  "allowed_generated": [
    "__pycache__/",
    "tests/__pycache__/"
  ],
  "verify": [
    "python3",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
  ],
  "judge": [
    "python3",
    "-I",
    "judge/verify.py"
  ],
  "required_tools": [
    "python3",
    "/bin/sh"
  ],
  "self_test": {
    "initial_case": "casefold",
    "fixed_output": "pass\n",
    "controls": [
      {
        "source": "negative/break_default.py",
        "cases": [
          "default"
        ]
      }
    ],
    "fixed_output_cases": [
      "casefold",
      "default",
      "empty_lines",
      "crlf"
    ]
  }
}
