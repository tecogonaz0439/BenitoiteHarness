{
  "kind": "normal",
  "category": "feature",
  "artifacts": [
    "replace.py"
  ],
  "writable_files": [
    "replace.py"
  ],
  "allowed_generated": [
    "__pycache__/",
    "tests/__pycache__/"
  ],
  "verify": [
    "python3",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
  ],
  "judge": [
    "python3",
    "-I",
    "judge/verify.py"
  ],
  "required_tools": [
    "python3",
    "/bin/sh"
  ],
  "self_test": {
    "initial_case": "preview",
    "fixed_output": "pass\n",
    "controls": [
      {
        "source": "negative/break_normal.py",
        "cases": [
          "normal",
          "no_match",
          "normal_crlf",
          "replacement_backslashes"
        ]
      }
    ],
    "fixed_output_cases": [
      "preview",
      "normal",
      "literal",
      "delete",
      "normal_crlf",
      "replacement_backslashes"
    ]
  }
}
